{
  "name": "@dqnamo/voicecontrol",
  "version": "0.0.1",
  "description": "Composable React primitives for building voice-controlled web interfaces.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "voice-control",
    "speech",
    "react",
    "accessibility",
    "jev"
  ],
  "author": "dqnamo",
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
